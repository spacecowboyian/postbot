# PostBot environment variables
# Copy to .env and fill in real values. Never commit .env.

# ----------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------
SUPABASE_URL=https://zdjughkxryhabduhsdgg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}  # Rotate after any accidental exposure. Settings > API > Service Role.
SUPABASE_ANON_KEY=${{ secrets.SUPABASE_ANON_KEY }}  # Used by dashboard only. Settings > API > anon public.

# ----------------------------------------------------------------
# Creatomate
# ----------------------------------------------------------------
CREATOMATE_API_KEY=${{ secrets.CREATOMATE_API_KEY }}  # From Creatomate dashboard > API Keys

# ----------------------------------------------------------------
# Worker
# ----------------------------------------------------------------
WORKER_PORT=3001                  # Port for webhook receiver
WORKER_URL=${{ secrets.WORKER_URL }}  # Public URL of the worker for Creatomate webhooks e.g. https://postbot.yourdomain.com
CREATOMATE_WEBHOOK_SECRET=${{ secrets.CREATOMATE_WEBHOOK_SECRET }}  # Set in Creatomate dashboard, used to verify webhook signatures

# ----------------------------------------------------------------
# Platform credentials (OIO Racing)
# accounts.credentials_ref values point to these env var names
# ----------------------------------------------------------------
OIO_INSTAGRAM_TOKEN=${{ secrets.OIO_INSTAGRAM_TOKEN }}  # Instagram Graph API access token
OIO_INSTAGRAM_ACCOUNT_ID=${{ secrets.OIO_INSTAGRAM_ACCOUNT_ID }}  # Instagram business account ID
OIO_YOUTUBE_CLIENT_ID=${{ secrets.OIO_YOUTUBE_CLIENT_ID }}  # Google OAuth client ID
OIO_YOUTUBE_CLIENT_SECRET=${{ secrets.OIO_YOUTUBE_CLIENT_SECRET }}  # Google OAuth client secret
OIO_YOUTUBE_REFRESH_TOKEN=${{ secrets.OIO_YOUTUBE_REFRESH_TOKEN }}  # YouTube OAuth refresh token (long-lived)

# ----------------------------------------------------------------
# Platform credentials (Tiny Prints)
# ----------------------------------------------------------------
TINYPRINTS_INSTAGRAM_TOKEN=${{ secrets.TINYPRINTS_INSTAGRAM_TOKEN }}
TINYPRINTS_INSTAGRAM_ACCOUNT_ID=${{ secrets.TINYPRINTS_INSTAGRAM_ACCOUNT_ID }}

# ----------------------------------------------------------------
# Platform credentials (Personal)
# ----------------------------------------------------------------
PERSONAL_INSTAGRAM_TOKEN=${{ secrets.PERSONAL_INSTAGRAM_TOKEN }}
PERSONAL_INSTAGRAM_ACCOUNT_ID=${{ secrets.PERSONAL_INSTAGRAM_ACCOUNT_ID }}
PERSONAL_THREADS_TOKEN=${{ secrets.PERSONAL_THREADS_TOKEN }}  # Threads API access token (Meta)
PERSONAL_THREADS_USER_ID=${{ secrets.PERSONAL_THREADS_USER_ID }}

# ----------------------------------------------------------------
# Optional: Cloudflare R2 (if used instead of Supabase Storage for video)
# ----------------------------------------------------------------
R2_ACCOUNT_ID=${{ secrets.R2_ACCOUNT_ID }}
R2_ACCESS_KEY_ID=${{ secrets.R2_ACCESS_KEY_ID }}
R2_SECRET_ACCESS_KEY=${{ secrets.R2_SECRET_ACCESS_KEY }}
R2_BUCKET_NAME=postbot-media
R2_PUBLIC_URL=${{ secrets.R2_PUBLIC_URL }}  # e.g. https://media.yourdomain.com
